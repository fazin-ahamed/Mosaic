{"nodes": [{"id": "artifacts_d2_cpu_adapter_v2_vnni_source_adapter", "label": "VNNI Source Adapter (Three-Plane E4M3/E2M1)", "file_type": "concept", "source_file": "artifacts/d2_cpu_adapter_v2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source V4 activations are signed/fractional full-range finite E4M3; historical unsigned 0..15 microbenchmarks never exercised them. The adapter keeps qA=512*A and qW=2*W, offsets qA by 2^18 into three unsigned byte planes, reconstructs the K32 integer dot, subtracts int32 per-block weight-sum compensation, then applies source block scales with ordered FP32 reduction, compiled without FP contraction."}], "edges": [{"source": "artifacts_d2_cpu_adapter_v2_vnni_source_adapter", "target": "artifacts_roadmap_pre_d1b_mxie", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "artifacts/d2_cpu_adapter_v2.md", "source_location": null, "weight": 1.0}, {"source": "artifacts_d2_cpu_adapter_v2_vnni_source_adapter", "target": "agents_rtx3060_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "artifacts/d2_cpu_adapter_v2.md", "source_location": null, "weight": 1.0}, {"source": "artifacts_d2_cpu_adapter_v2_vnni_source_adapter", "target": "artifacts_session_vnni_v4_report_vnni_v4b", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "artifacts/d2_cpu_adapter_v2.md", "source_location": null, "weight": 1.0}], "hyperedges": []}